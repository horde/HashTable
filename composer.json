{
    "name": "horde/hashtable",
    "description": "Hash table client library",
    "type": "library",
    "homepage": "https://www.horde.org",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "time": "2026-06-15",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {
        "horde/argv": "^3 || dev-FRAMEWORK_6_0",
        "horde/cli": "^3 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "horde/argv": "^3 || dev-FRAMEWORK_6_0",
        "horde/cli": "^3 || dev-FRAMEWORK_6_0",
        "horde/log": "^3 || dev-FRAMEWORK_6_0",
        "horde/memcache": "^3 || dev-FRAMEWORK_6_0",
        "horde/vfs": "^3 || dev-FRAMEWORK_6_0",
        "predis/predis": "^2 || ^3"
    },
    "autoload": {
        "psr-0": {
            "Horde_HashTable": "lib/"
        },
        "psr-4": {
            "Horde\\HashTable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\HashTable\\Test\\Lib\\Unit\\": "test/lib/Unit",
            "Horde\\HashTable\\Test\\Lib\\Integration\\": "test/lib/Integration",
            "Horde\\HashTable\\Test\\Src\\Unit\\": "test/src/Unit",
            "Horde\\HashTable\\Test\\Src\\Integration\\": "test/src/Integration"
        }
    },
    "bin": [
        "bin/horde-redis-tester"
    ],
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "2.x-dev"
        }
    }
}